# Copy to deploy/.env and fill in. .env is git-ignored. Never commit real values.
VH_USER=reviewer
VH_PASS=change-me-to-12-or-more-characters
# Public host name and link when you reach VideoHub through a tunnel or reverse proxy (optional)
VH_ALLOWED_HOSTS=review.example.com
VH_PUBLIC_URL=https://review.example.com
# Review repo for two-way sync (films from the cloud, notes back)
FILMS_REPO=https://github.com/your-name/your-review-repo.git
FILMS_BRANCH=main
GIT_TOKEN=github-token-with-contents-write-on-that-repo
SYNC_EVERY=60
# Cloudflare Tunnel token (only for the tunnel profile). Paste it whole: a cut-off token fails to connect.
TUNNEL_TOKEN=
